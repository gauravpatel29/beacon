# Copy to .env.local (git-ignored) and edit. Both vars are optional; the
# defaults below match how the app behaves with no .env file at all.

# Base URL the browser calls. Inlined into the bundle at build time.
#   empty            same-origin — in dev the Vite proxy forwards to BEACON_API
#   https://host     absolute, bypasses the proxy (tunnel, or a deployed API)
# A production build has no proxy, so set this for any deploy where the API
# is not served from the same origin as the app.
VITE_API_BASE_URL=

# Dev-server proxy target. Only read by `npm run dev`, never sent to the
# browser. Ignored when VITE_API_BASE_URL is an absolute URL.
BEACON_API=http://127.0.0.1:8000
