# ─── Neon Postgres ────────────────────────────────────────────────────────────
# Console → Project "Beacon" (hidden-firefly-04845654) → Dashboard → Connect
#   • Branch: production   • Database: neondb   • Role: neondb_owner
#   • Toggle "Pooled connection" ON  → paste as DATABASE_URL
#   • Toggle "Pooled connection" OFF → paste as DATABASE_URL_UNPOOLED
# Keep the ?sslmode=require suffix. Use the pooled URL for the API; the
# unpooled one is only for DDL/migrations (pgbouncer breaks transactional DDL).
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# ─── Neon Object Storage (S3-compatible) ──────────────────────────────────────
# Console → same project → Storage → bucket "data" → "Connection details" /
# "Generate credentials". Copy the access key pair it shows you ONCE.
# (CLI equivalent: `neon storage credentials --project-id hidden-firefly-04845654`)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Non-secret — already correct for this project's `production` branch.
AWS_ENDPOINT_URL_S3=https://br-morning-wind-axeccd4h.storage.c-4.us-east-2.aws.neon.tech
AWS_REGION=us-east-2
NEON_BUCKET=data
NEON_BRANCH=production

# Object keys are namespaced under this prefix so this project can be shared
# with the reference Beacon/Server implementation without collisions.
STORAGE_PREFIX=beacon

# ─── Limits ───────────────────────────────────────────────────────────────────
MAX_UPLOAD_BYTES=209715200
PRESIGN_EXPIRY_SECONDS=900
